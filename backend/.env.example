# Copy this file to .env:   cp .env.example .env
# .env is in .gitignore and must NEVER be committed.

PORT=3000
NODE_ENV=development

# Frontend origins allowed by CORS, comma-separated, no trailing slash
CORS_ORIGINS=http://localhost:8080

# Secret used to check login tokens. It must be the SAME value the login part signs with.
# Make your own random one (Git Bash):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# memory   = no setup, everything is lost when the API stops (quick local testing)
# dynamodb = DynamoDB tables on Floci (docker-compose sets this for you)
DATA_STORE=memory

# Floci (local AWS). The keys are dummy values, "test" is not a secret.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
MEALPLANS_TABLE=MealPlans
SHOPPINGLISTS_TABLE=ShoppingLists
AUTO_CREATE_TABLES=true

# sample  = built-in sample recipes (until the Recipe Library service is merged)
# library = recipes from backend/services/recipeService.js
RECIPE_SOURCE=sample

# info, warn, error or silent
LOG_LEVEL=info
# Send logs to CloudWatch Logs on Floci (log group /recipe-organizer/api)
LOG_TO_CLOUDWATCH=false
