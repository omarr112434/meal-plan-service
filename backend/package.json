{
  "name": "mealplan-api",
  "version": "1.0.0",
  "description": "Recipe Organizer + Meal Plan (Team 07): Meal Plan and Shopping List service API",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "test:floci": "node scripts/test-plan.js floci",
    "test:memory": "node scripts/test-plan.js memory",
    "dev-token": "node scripts/dev-token.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1170.0",
    "@aws-sdk/client-dynamodb": "^3.1170.0",
    "@aws-sdk/client-secrets-manager": "^3.1175.0",
    "@aws-sdk/lib-dynamodb": "^3.1170.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "serverless-http": "^3.2.0"
  }
}
